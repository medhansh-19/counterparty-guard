{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@counterparty-guard/shared": [
        "packages/shared/src/index.ts"
      ],
      "@counterparty-guard/providers": [
        "packages/providers/src/index.ts"
      ],
      "@counterparty-guard/scoring": [
        "packages/scoring/src/index.ts"
      ],
      "@counterparty-guard/shared/demo": [
        "packages/shared/src/demo.ts"
      ],
      "@counterparty-guard/reputation": [
        "packages/reputation/src/index.ts"
      ],
      "@counterparty-guard/fixtures": [
        "fixtures/index.ts"
      ],
      "@counterparty-guard/shared/browser": [
        "packages/shared/src/browser.ts"
      ],
      "@counterparty-guard/guard": [
        "packages/guard/src/index.ts"
      ]
    }
  },
  "include": [
    "apps/api/**/*.ts",
    "packages/shared/**/*.ts",
    "packages/providers/**/*.ts",
    "packages/scoring/**/*.ts",
    "scripts/person-a/**/*.ts",
    "tests/integration/**/*.ts",
    "vitest*.ts",
    "packages/reputation/**/*.ts",
    "fixtures/**/*.ts",
    "scripts/demo/**/*.ts",
    "tests/regression/**/*.ts",
    "packages/guard/**/*.ts",
    "scripts/chain/**/*.ts",
    "tests/e2e/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "artifacts",
    "**/dist/**",
    "**/dist-ts/**",
    "apps/api/tests/**",
    "packages/reputation/tests/**",
    "packages/shared/tests/**",
    "scripts/demo/tests/**",
    "fixtures/tests/**",
    "tests/regression/**"
  ]
}
