{
  "name": "counterparty-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.22.1 || ^26.7.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.c-tests.json && pnpm --filter web typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "bash scripts/chain/test.sh",
    "demo:attack": "tsx scripts/demo/run-attack.ts",
    "demo:all": "bash scripts/chain/demo-all.sh",
    "dev:api": "tsx apps/api/src/server.ts",
    "setup:local": "tsx scripts/person-a/setup-local.ts",
    "smoke:api": "tsx scripts/person-a/smoke.ts",
    "verify:interfaces": "tsx scripts/person-a/verify-interfaces.ts",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test:contracts": "bash scripts/chain/test.sh",
    "demo:fixtures": "tsx scripts/demo/run-all.ts",
    "demo:sandbox": "bash scripts/chain/test.sh"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "zod": "4.6.7",
    "better-sqlite3": "13.0.3",
    "@counterparty-guard/reputation": "workspace:*",
    "@counterparty-guard/fixtures": "workspace:*",
    "@counterparty-guard/shared": "workspace:*"
  }
}
